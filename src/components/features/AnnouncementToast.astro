---
import { Icon } from "astro-icon/components";
import { announcementConfig } from "@/config";

const config = announcementConfig;
---

{/* 公告弹窗：进场动画结束后在右下角弹出，2s 后自动关闭，也可手动关闭 */}
<div
  id="announcement-toast"
  class="announcement-toast"
  role="status"
  aria-live="polite"
>
  <div class="announcement-toast-icon">
    <Icon is:inline name="material-symbols:campaign-outline-rounded" />
  </div>
  <div class="announcement-toast-body">
    {config.title && <div class="announcement-toast-title">{config.title}</div>}
    <div class="announcement-toast-content">{config.content}</div>
    {config.link && config.link.enable !== false && (
      <a
        href={config.link.url}
        target={config.link.external ? "_blank" : "_self"}
        rel={config.link.external ? "noopener noreferrer" : undefined}
        class="announcement-toast-link"
      >
        {config.link.text}
      </a>
    )}
  </div>
  <button
    type="button"
    class="announcement-toast-close"
    aria-label="关闭公告"
  >
    <Icon is:inline name="fa7-solid:xmark" class="text-sm" />
  </button>
</div>

<script is:inline>
  (function () {
    var toast = document.getElementById("announcement-toast");
    if (!toast) return;

    // 每次会话只弹一次
    try {
      if (sessionStorage.getItem("announcement-toast-shown")) return;
    } catch (e) {}

    var shown = false;
    var timer = null;

    function show() {
      if (shown) return;
      shown = true;
      // 标记本会话已展示，刷新后不再重复弹出
      try {
        sessionStorage.setItem("announcement-toast-shown", "1");
      } catch (e) {}
      toast.classList.add("show");
      // 5s 后自动关闭
      timer = setTimeout(function () {
        toast.classList.remove("show");
      }, 5000);
    }

    // 手动关闭
    var closeBtn = toast.querySelector(".announcement-toast-close");
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        toast.classList.remove("show");
        if (timer) clearTimeout(timer);
      });
    }

    // 进场动画在播：等它结束再弹；否则（跳过/禁用）稍后直接弹
    if (document.documentElement.dataset.entrance === "show") {
      window.addEventListener("firefly:entrance-done", show, { once: true });
      // 兜底：万一事件没触发
      setTimeout(function () {
        if (!shown) show();
      }, 4000);
    } else {
      setTimeout(show, 600);
    }
  })();
</script>

<style is:global>
  #announcement-toast {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 9000;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 22rem;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--card-bg);
    border: 1px solid var(--line-divider);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  #announcement-toast.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #announcement-toast .announcement-toast-icon {
    flex-shrink: 0;
    font-size: 1.25rem;
    color: var(--primary);
    margin-top: 0.1rem;
  }

  #announcement-toast .announcement-toast-title {
    font-weight: 600;
    color: var(--deep-text);
    margin-bottom: 0.25rem;
  }

  .dark #announcement-toast .announcement-toast-title {
    color: oklch(0.92 0.01 var(--hue));
  }

  #announcement-toast .announcement-toast-content {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--content-meta);
  }

  #announcement-toast .announcement-toast-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary);
  }

  #announcement-toast .announcement-toast-close {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    color: var(--content-meta);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  #announcement-toast .announcement-toast-close:hover {
    background: var(--btn-regular-bg-hover);
  }
</style>
